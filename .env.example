# Local replay is usable without any account or model server.
MARKET_EVENTS_MODE=replay
MARKET_EVENTS_DATABASE=data/market_events.sqlite
# demo keeps bundled synthetic records separate from the real-data namespace.
# The dashboard also lets you select the active universe explicitly.
MARKET_EVENTS_UNIVERSE=demo

# Real Indian daily price history and news: free Upstox read-only Analytics Token.
# Generate it in Upstox Developer Apps > Analytics. No OAuth redirect is needed.
# Never commit a real token. Restart Streamlit after changing your local .env.
UPSTOX_ANALYTICS_TOKEN=
# UPSTOX_ACCESS_TOKEN is accepted as a lower-priority alias.

# Hosted Sarvam models; no local model installation is required.
# The key alone selects the supported Sarvam defaults for both analysis roles.
SARVAM_API_KEY=
# Optional overrides for another OpenAI-compatible service:
# SLM_PROVIDER=openai_compatible
# SLM_BASE_URL=https://api.sarvam.ai/v1
# SLM_MODEL=sarvam-105b-conversations
# SLM_API_KEY=
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.sarvam.ai/v1
# LLM_MODEL=sarvam-105b
# LLM_API_KEY=
# Optional model override for Portfolio case suggestions on the same LLM endpoint.
PORTFOLIO_MODEL=
# Vercel: connect a Neon database to Production. These are server-only secrets.
# Leave empty for local SQLite. Never prefix database or provider secrets with NEXT_PUBLIC_.
DATABASE_URL=
# Optional explicit override takes precedence over DATABASE_URL.
MARKET_EVENTS_DATABASE_URL=

# Optional broker holdings import; paper money works without these credentials.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:3000/api/portfolio/upstox
